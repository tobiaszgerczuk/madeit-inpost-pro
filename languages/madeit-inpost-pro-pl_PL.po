msgid "MadeIT InPost Pro"
msgstr "MadeIT InPost Pro"

#. Plugin URI of the plugin
#: madeit-inpost-pro.php
msgid "https://labs.made-it.pl/en/plugins/madeit-inpost-pro"
msgstr ""

#. Description of the plugin
#: madeit-inpost-pro.php
msgid "Adds InPost ShipX shipments, PDF labels and cash on delivery to MadeIT InPost, plus editable texts and an accent colour."
msgstr "Dodaje do MadeIT InPost przesyłki ShipX, etykiety PDF i pobranie, a także edycję tekstów i kolor akcentu."

#. Author of the plugin
#: madeit-inpost-pro.php
msgid "WCO Labs"
msgstr ""

#. Author URI of the plugin
#: madeit-inpost-pro.php
msgid "https://labs.made-it.pl/en"
msgstr ""

#: madeit-inpost-pro.php:39
msgid "MadeIT InPost Pro needs the free MadeIT InPost plugin to be installed and active."
msgstr "MadeIT InPost Pro wymaga zainstalowanej i aktywnej darmowej wtyczki MadeIT InPost."

#. translators: %s: minimum version of the free plugin
#: madeit-inpost-pro.php:48
#, php-format
msgid "MadeIT InPost Pro needs MadeIT InPost %s or newer. Please update the free plugin."
msgstr "MadeIT InPost Pro wymaga MadeIT InPost w wersji %s lub nowszej. Zaktualizuj darmową wtyczkę."

